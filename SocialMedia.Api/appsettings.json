{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "SwaggerEnabled": true,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "Jwt": {
